<!DOCTYPE html>
<html>
  <head>
    <title>Flexbox 없이 - 기본값</title>
    <style>
      /* 박스 공통 모양 */
      .box {
        color: white;
        padding: 20px;
        margin-bottom: 10px;
        border-radius: 10px;
        font-weight: bold;
      }

      /* 각 박스 색상 */
      .box1 { background-color: #11a3c1; }
      .box2 { background-color: #0e6c87; }
      .box3 { background-color: #111a31; }
    </style>
  </head>
  <body>

    <!-- 교수님이 강조하신 id="container" -->
    <div id="container">
      <div class="box box1">박스1</div>
      <div class="box box2">박스2</div>
      <div class="box box3">박스3</div>
    </div>

  </body>
</html>
